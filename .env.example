# Copy to .env and set your own password. Never commit .env.
# Used by docker-compose.yml and by the backend's local profile.
POSTGRES_DB=seatsense
POSTGRES_USER=seatsense
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Password for the sample login accounts (gate, librarian, admin, sample.student1 to 5), created on a local run.
SAMPLE_PASSWORD=change-me
